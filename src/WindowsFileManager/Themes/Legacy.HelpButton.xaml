<!--
    HelpButtonStyle, lifted verbatim out of MainWindow.xaml by T-002.

    Same parse-time argument as Converters.xaml: 21 call sites across five of the nine extracted
    controls reference this key, so it cannot stay on the Window.

    Moved WHOLE and unedited - the ControlTemplate, its Popup, the FormattedTextBehavior binding
    and both ControlTemplate.Triggers. T-003 restyles its CONTENTS in place; the file name is
    T-003's choice, adopted here so the block is never relocated twice.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:WindowsFileManager.Helpers">
        <!-- Help Button Style: small ? circle that shows a popup on click -->
        <Style x:Key="HelpButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Legacy.Brush.Action.Primary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Circle" Width="16" Height="16" CornerRadius="8"
                                    Background="{DynamicResource Legacy.Brush.Surface.InfoTint}" BorderBrush="{DynamicResource Legacy.Brush.Action.FocusLight}" BorderThickness="1">
                                <TextBlock Text="?" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Legacy.Brush.Action.Primary}" Margin="0,-1,0,0" />
                            </Border>
                            <Popup x:Name="HelpPopup" IsOpen="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}"
                                   StaysOpen="False" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="{DynamicResource Legacy.Brush.Help.Bg}" BorderBrush="{DynamicResource Legacy.Brush.Help.Border}" BorderThickness="1"
                                        CornerRadius="6" Padding="12,10" MaxWidth="380">
                                    <Border.Effect>
                                        <DropShadowEffect Color="{DynamicResource Legacy.Color.Shadow}" Opacity="0.15" BlurRadius="8" ShadowDepth="2" />
                                    </Border.Effect>
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" FontWeight="Normal"
                                               Foreground="{DynamicResource Legacy.Brush.Fg.Strong}" LineHeight="18"
                                               helpers:FormattedTextBehavior.FormattedText="{TemplateBinding Tag}" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="{DynamicResource Legacy.Brush.Action.HoverTint}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="{DynamicResource Legacy.Brush.Action.Primary}" />
                                <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource Legacy.Brush.Action.PrimaryDark}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

</ResourceDictionary>
