<!--
    Broadsheet design tokens - the design system option 3a is drawn in.

    TRANSCRIBED, NOT AUTHORED. Every value below is read verbatim from the vendored
    design system at docs/design/canvas/_ds/broadsheet-20e204aa-.../styles.css (:root).
    That file is a frozen artifact (docs/design/_index.md) - if a value here disagrees
    with it, this file is wrong.

    DEFINED HERE, CONSUMED BY NOTHING IN T-001. The app keeps its existing palette
    byte-for-byte; T-001's acceptance bar is pixel-equivalence. T-003 onwards binds to
    these keys as it rebuilds each surface.

    LIGHT ONLY. There is no dark ramp, no theme switch, no colour-as-meaning layer.
    That is goal 4a and it is deliberately absent - see T-001 "Out of scope" and
    docs/design/DESIGN-001-ide-frame-redesign.md.

    Every brush is DynamicResource-consumable: nothing here is referenced with
    StaticResource by a rendered surface, so a future theme goal swaps this one
    dictionary rather than rewriting the app.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

    <!-- Ground and ink -->
    <SolidColorBrush x:Key="Broadsheet.Brush.Bg" Color="#FFF3F2F2" po:Freeze="True" /><!-- css: color-bg -->
    <SolidColorBrush x:Key="Broadsheet.Brush.Surface" Color="#FFEAE9E9" po:Freeze="True" /><!-- css: color-surface -->
    <SolidColorBrush x:Key="Broadsheet.Brush.Text" Color="#FF201E1D" po:Freeze="True" /><!-- css: color-text -->

    <!--
        Divider. The design system declares this as
            color-mix(in srgb, #201e1d 16%, transparent)
        and WPF has no color-mix. Shipped as the ALPHA form so one key composites
        correctly over every ground it runs on - the same hairline is drawn over
        Bg, Surface and Neutral100. The baked opaque equivalents, for reference:
            over Bg #f3f2f2         -> #D1D0D0
            over Surface #eae9e9    -> #CAC9C8
            over Neutral100 #f8f4f4 -> #D5D2D2
        0x29 = 41/255 = 16%.
    -->
    <SolidColorBrush x:Key="Broadsheet.Brush.Divider" Color="#29201E1D" po:Freeze="True" />

    <!-- Neutral ramp -->
    <SolidColorBrush x:Key="Broadsheet.Brush.Neutral100" Color="#FFF8F4F4" po:Freeze="True" />
    <SolidColorBrush x:Key="Broadsheet.Brush.Neutral200" Color="#FFEAE7E7" po:Freeze="True" />
    <SolidColorBrush x:Key="Broadsheet.Brush.Neutral300" Color="#FFD7D3D3" po:Freeze="True" />
    <SolidColorBrush x:Key="Broadsheet.Brush.Neutral400" Color="#FFBAB6B6" po:Freeze="True" />
    <SolidColorBrush x:Key="Broadsheet.Brush.Neutral500" Color="#FF9B9797" po:Freeze="True" />
    <SolidColorBrush x:Key="Broadsheet.Brush.Neutral600" Color="#FF7D7979" po:Freeze="True" />
    <SolidColorBrush x:Key="Broadsheet.Brush.Neutral700" Color="#FF605D5D" po:Freeze="True" />
    <SolidColorBrush x:Key="Broadsheet.Brush.Neutral800" Color="#FF444141" po:Freeze="True" />
    <SolidColorBrush x:Key="Broadsheet.Brush.Neutral900" Color="#FF2D2B2B" po:Freeze="True" />

    <!-- Accent ramp (cyan) -->
    <SolidColorBrush x:Key="Broadsheet.Brush.Accent100" Color="#FFE9F8FF" po:Freeze="True" />
    <SolidColorBrush x:Key="Broadsheet.Brush.Accent200" Color="#FFCBEEFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Broadsheet.Brush.Accent300" Color="#FF99E0FF" po:Freeze="True" />
    <SolidColorBrush x:Key="Broadsheet.Brush.Accent400" Color="#FF62C5EE" po:Freeze="True" />
    <SolidColorBrush x:Key="Broadsheet.Brush.Accent500" Color="#FF38A6CF" po:Freeze="True" />
    <SolidColorBrush x:Key="Broadsheet.Brush.Accent600" Color="#FF1186AC" po:Freeze="True" />
    <SolidColorBrush x:Key="Broadsheet.Brush.Accent700" Color="#FF006786" po:Freeze="True" />
    <SolidColorBrush x:Key="Broadsheet.Brush.Accent800" Color="#FF004961" po:Freeze="True" />
    <SolidColorBrush x:Key="Broadsheet.Brush.Accent900" Color="#FF0A303E" po:Freeze="True" />

    <!-- Accent-2 ramp (magenta) -->
    <SolidColorBrush x:Key="Broadsheet.Brush.Accent2100" Color="#FFFFF1F4" po:Freeze="True" />
    <SolidColorBrush x:Key="Broadsheet.Brush.Accent2200" Color="#FFFFDEE6" po:Freeze="True" />
    <SolidColorBrush x:Key="Broadsheet.Brush.Accent2300" Color="#FFFFC0D0" po:Freeze="True" />
    <SolidColorBrush x:Key="Broadsheet.Brush.Accent2400" Color="#FFFF90B1" po:Freeze="True" />
    <SolidColorBrush x:Key="Broadsheet.Brush.Accent2500" Color="#FFFF458E" po:Freeze="True" />
    <SolidColorBrush x:Key="Broadsheet.Brush.Accent2600" Color="#FFD82071" po:Freeze="True" />
    <SolidColorBrush x:Key="Broadsheet.Brush.Accent2700" Color="#FFAA0B56" po:Freeze="True" />
    <SolidColorBrush x:Key="Broadsheet.Brush.Accent2800" Color="#FF790E3D" po:Freeze="True" />
    <SolidColorBrush x:Key="Broadsheet.Brush.Accent2900" Color="#FF4B1528" po:Freeze="True" />

    <!-- Base accents. Accent2 and ProcessYellow ship as PALETTE ENTRIES with no
         semantic name and no consumer - naming them Destructive/Warning would be the
         first row of the 4a colour-semantics layer. -->
    <SolidColorBrush x:Key="Broadsheet.Brush.Accent" Color="#FF0088B0" po:Freeze="True" />
    <SolidColorBrush x:Key="Broadsheet.Brush.Accent2" Color="#FFD6006C" po:Freeze="True" />
    <SolidColorBrush x:Key="Broadsheet.Brush.ProcessYellow" Color="#FFEDBB00" po:Freeze="True" />

    <!-- Radii -->
    <CornerRadius x:Key="Broadsheet.Radius.Sm">1</CornerRadius>
    <CornerRadius x:Key="Broadsheet.Radius.Md">2</CornerRadius>
    <CornerRadius x:Key="Broadsheet.Radius.Lg">4</CornerRadius>

    <!-- Space scale -->
    <sys:Double x:Key="Broadsheet.Space.1">5</sys:Double>
    <sys:Double x:Key="Broadsheet.Space.2">10</sys:Double>
    <sys:Double x:Key="Broadsheet.Space.3">15</sys:Double>
    <sys:Double x:Key="Broadsheet.Space.4">20</sys:Double>
    <sys:Double x:Key="Broadsheet.Space.6">30</sys:Double>
    <sys:Double x:Key="Broadsheet.Space.8">40</sys:Double>

    <!--
        Typography. The design system sets both faces to "Source Serif 4", a
        Google-hosted webfont; WPF has no @import, so a custom face would have to be
        embedded as a Resource and referenced by pack:// URI.

        USER DECISION (2026-09-04, T-001 DECISION 1): option (b) CAMBRIA.
        Cambria ships with every supported Windows and was designed for on-screen
        reading at small sizes. That is the deciding factor here: the canvas sets its
        body text at 15px, while this application's chrome renders at 11-13px, which is
        exactly where a display serif degrades. Cambria keeps the press-ink character
        at zero repo weight, zero MSIX payload and no OFL licence file.
    -->
    <FontFamily x:Key="Broadsheet.FontFamily.Heading">Cambria</FontFamily>
    <FontFamily x:Key="Broadsheet.FontFamily.Body">Cambria</FontFamily>
    <FontFamily x:Key="Broadsheet.FontFamily.Mono">Consolas</FontFamily>
    <sys:Double x:Key="Broadsheet.FontWeight.Heading">600</sys:Double><!-- css: font-heading-weight -->

    <!--
        RESERVED, INTENTIONALLY EMPTY: Broadsheet.Style.*, Broadsheet.Template.*,
        Broadsheet.Converter.*. These categories are published by T-001 as the naming
        contract and defined by T-003. T-001 authoring one would put a rendered-surface
        change in the task whose whole purpose is to change nothing.
    -->

</ResourceDictionary>
