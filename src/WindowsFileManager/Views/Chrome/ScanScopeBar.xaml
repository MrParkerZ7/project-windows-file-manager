<UserControl x:Class="WindowsFileManager.Views.Chrome.ScanScopeBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:WindowsFileManager.Helpers">
    <!-- Row 0: Target Folders + Exclude Folders (50/50 side by side) -->
    <Grid Margin="4,4,4,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: Target Folders -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource Legacy.Brush.Border.Mid}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,2,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header row -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="Target Folders" FontWeight="Bold" FontSize="12"
                               VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <CheckBox Content="Include subdirectories"
                                  IsChecked="{Binding IncludeSubdirectories}"
                                  IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}"
                                  VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ToggleButton Style="{StaticResource HelpButtonStyle}"
                                      Margin="0,0,8,0"
                                      Tag="&lt;h&gt;WHERE TO SCAN&lt;/h&gt;&#x0a;Add folders that may contain duplicate files.&#x0a;&#x0a;&lt;b&gt;Include subdirectories&lt;/b&gt; = scan all nested folders too&#x0a;&lt;b&gt;Multiple folders&lt;/b&gt; = compare files across different locations&#x0a;&lt;b&gt;✓ All / ✕ Clear&lt;/b&gt; = enable or disable every target at once&#x0a;&#x0a;&lt;h&gt;How it works:&lt;/h&gt; Files are compared by &lt;b&gt;content hash (SHA-256)&lt;/b&gt;, not by name. Two files with different names but identical content are detected as duplicates." />
                        <Button Content="✓ All" Command="{Binding SelectAllTargetsCommand}"
                                Padding="6,2" Margin="0,0,4,0" FontSize="10" Cursor="Hand"
                                ToolTip="Enable all target folders" />
                        <Button Content="✕ Clear" Command="{Binding ClearAllTargetsCommand}"
                                Padding="6,2" FontSize="10" Cursor="Hand"
                                Foreground="{DynamicResource Legacy.Brush.Fg.Muted}" ToolTip="Disable all target folders" />
                    </StackPanel>
                </Grid>

                <!-- Path input + buttons -->
                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding NewFolderPath, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,4" VerticalContentAlignment="Center"
                             IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}"
                             helpers:TextBoxEnterKeyBehavior.Command="{Binding AddFolderByPathCommand}" />

                    <Button Grid.Column="1" Content="Add"
                            Command="{Binding AddFolderByPathCommand}"
                            Padding="12,4" Margin="6,0,0,0"
                            IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}" />

                    <Button Grid.Column="2" Content="Browse..."
                            Command="{Binding AddFolderCommand}"
                            Padding="12,4" Margin="6,0,0,0"
                            IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}" />
                </Grid>

                <!-- Folder chips -->
                <ItemsControl Grid.Row="2" ItemsSource="{Binding TargetPaths}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="6,3" Margin="0,0,6,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Legacy.Brush.Surface.Accent}" />
                                            <Setter Property="Opacity" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource Legacy.Brush.Surface.Sunken}" />
                                                    <Setter Property="Opacity" Value="0.6" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"
                                                  Margin="0,0,4,0" Cursor="Hand"
                                                  ToolTip="Enable or disable this path temporarily" />
                                        <TextBlock Text="{Binding Value}" VerticalAlignment="Center"
                                                   FontSize="11" Foreground="{DynamicResource Legacy.Brush.Fg.Strong}"
                                                   ToolTip="{Binding Value}" />
                                        <Button Content="✕"
                                                Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Padding="2,0" Margin="6,0,0,0"
                                                FontSize="9" Foreground="{DynamicResource Legacy.Brush.Danger.Fg}" Cursor="Hand"
                                                Background="Transparent" BorderThickness="0"
                                                ToolTip="Remove this folder" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
            </Grid>
        </Border>

        <!-- Right: Exclude Folders -->
        <Border Grid.Column="1" BorderBrush="{DynamicResource Legacy.Brush.Border.Mid}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="2,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header row -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="Exclude Folders" FontWeight="Bold" FontSize="12"
                               Foreground="{DynamicResource Legacy.Brush.Warn.Fg}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="✓ All" Command="{Binding SelectAllExcludesCommand}"
                                Padding="6,2" Margin="0,0,4,0" FontSize="10" Cursor="Hand"
                                Foreground="{DynamicResource Legacy.Brush.Warn.Fg}" ToolTip="Enable all exclude folders" />
                        <Button Content="✕ Clear" Command="{Binding ClearAllExcludesCommand}"
                                Padding="6,2" FontSize="10" Cursor="Hand"
                                Foreground="{DynamicResource Legacy.Brush.Fg.Muted}" ToolTip="Disable all exclude folders" />
                    </StackPanel>
                </Grid>

                <!-- Input + add -->
                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding NewExcludeFolderName, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,4" FontSize="11" VerticalContentAlignment="Center"
                             helpers:TextBoxEnterKeyBehavior.Command="{Binding AddExcludeFolderCommand}" />
                    <Button Grid.Column="1" Content="+ Add" Command="{Binding AddExcludeFolderCommand}"
                            Padding="8,4" Margin="6,0,0,0" FontSize="11" Cursor="Hand"
                            FontWeight="SemiBold" Foreground="{DynamicResource Legacy.Brush.Warn.Fg}" />
                    <ToggleButton Grid.Column="2" Style="{StaticResource HelpButtonStyle}" Margin="6,0,0,0"
                                  Tag="&lt;h&gt;EXCLUDE FOLDER NAMES&lt;/h&gt;&#x0a;Skip folders with these names during scanning.&#x0a;&#x0a;Matching is by &lt;b&gt;folder name only&lt;/b&gt; (not full path), case-insensitive.&#x0a;Any subfolder matching the name is skipped entirely.&#x0a;&#x0a;&lt;h&gt;Common examples:&lt;/h&gt;&#x0a;&lt;b&gt;node_modules&lt;/b&gt; — JavaScript dependencies&#x0a;&lt;b&gt;.git&lt;/b&gt; — Git internals&#x0a;&lt;b&gt;bin&lt;/b&gt; / &lt;b&gt;obj&lt;/b&gt; — Build output&#x0a;&lt;b&gt;__pycache__&lt;/b&gt; — Python cache" />
                </Grid>

                <!-- Exclude folder chips -->
                <ItemsControl Grid.Row="2" ItemsSource="{Binding ExcludeFolderNames}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="3" Padding="6,2" Margin="0,0,6,4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Legacy.Brush.Warn.TintStrong}" />
                                        <Setter Property="Opacity" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                <Setter Property="Background" Value="{DynamicResource Legacy.Brush.Surface.Sunken}" />
                                                <Setter Property="Opacity" Value="0.6" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"
                                              Margin="0,0,4,0" Cursor="Hand"
                                              ToolTip="Enable or disable this exclusion temporarily" />
                                    <TextBlock Text="{Binding Value}" VerticalAlignment="Center"
                                               FontSize="11" Foreground="{DynamicResource Legacy.Brush.Danger.Dark}" FontWeight="SemiBold" />
                                    <Button Content="✕"
                                            Command="{Binding DataContext.RemoveExcludeFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Padding="2,0" Margin="6,0,0,0"
                                            FontSize="9" Foreground="{DynamicResource Legacy.Brush.Danger.Fg}" Cursor="Hand"
                                            Background="Transparent" BorderThickness="0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
