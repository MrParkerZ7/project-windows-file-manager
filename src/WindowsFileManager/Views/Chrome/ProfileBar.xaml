<UserControl x:Class="WindowsFileManager.Views.Chrome.ProfileBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Profile Bar (docked to top, full width) -->
    <Border Background="{DynamicResource Legacy.Brush.Surface.Chrome}" BorderBrush="{DynamicResource Legacy.Brush.Border.Chrome}"
            BorderThickness="0,0,0,1" Padding="8,4" Margin="0,0,0,4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding ProfileOperationStatus}"
                       FontSize="10.5" FontStyle="Italic" Foreground="{DynamicResource Legacy.Brush.Success.Olive}"
                       VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="Profile:" FontWeight="Bold" FontSize="11"
                       VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Legacy.Brush.Fg.Slate}" />
            <ComboBox Grid.Column="2" x:Name="ProfileCombo"
                      ItemsSource="{Binding ProfileNames}"
                      SelectedItem="{Binding ActiveProfileName, Mode=TwoWay}"
                      MinWidth="180" FontSize="11" Padding="4,2"
                      VerticalAlignment="Center"
                      ToolTip="Switch active profile" />
            <Button Grid.Column="3" Content="+ New" Padding="8,3" Margin="8,0,0,0"
                    FontSize="11" Cursor="Hand" Foreground="{DynamicResource Legacy.Brush.Action.Primary}" FontWeight="SemiBold"
                    Click="NewProfile_Click"
                    ToolTip="Create a blank new profile (no target folders, no filters)" />
            <Button Grid.Column="4" Content="⎘ Clone" Padding="8,3" Margin="4,0,0,0"
                    FontSize="11" Cursor="Hand" Foreground="{DynamicResource Legacy.Brush.Success.FgDark}" FontWeight="SemiBold"
                    Click="CloneProfile_Click"
                    ToolTip="Clone the active profile (copies current state under a new name)" />
            <Button Grid.Column="5" Content="✎ Rename" Padding="8,3" Margin="4,0,0,0"
                    FontSize="11" Cursor="Hand" Foreground="{DynamicResource Legacy.Brush.Fg.SlateMid}"
                    Click="RenameProfile_Click"
                    ToolTip="Rename the active profile" />
            <Button Grid.Column="6" Content="🗑 Delete" Padding="8,3" Margin="4,0,0,0"
                    FontSize="11" Cursor="Hand" Foreground="{DynamicResource Legacy.Brush.Danger.Fg}"
                    Click="DeleteProfile_Click"
                    ToolTip="Delete the active profile (at least one must remain)" />
            <ToggleButton Grid.Column="7" Style="{StaticResource HelpButtonStyle}" Margin="8,0,0,0"
                          Tag="&lt;h&gt;PROFILES&lt;/h&gt;&#x0a;Each profile is a saved workspace — target folders, exclude folders, filters, folder-search patterns, and every per-tab selection.&#x0a;&#x0a;&lt;b&gt;+ New&lt;/b&gt; = create a blank profile (empty target folders, no filters)&#x0a;&lt;b&gt;⎘ Clone&lt;/b&gt; = copy the current profile under a new name&#x0a;&lt;b&gt;✎ Rename&lt;/b&gt; = rename the active profile&#x0a;&lt;b&gt;🗑 Delete&lt;/b&gt; = remove the active profile (at least one must remain)&#x0a;&#x0a;&lt;b&gt;Global&lt;/b&gt; (shared across profiles): window geometry, Action History log." />
        </Grid>
    </Border>
</UserControl>
