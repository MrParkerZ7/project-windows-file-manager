<UserControl x:Class="WindowsFileManager.Views.Screens.HistoryScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Analytics strip -->
        <Border Grid.Row="0" Background="{DynamicResource Legacy.Brush.Surface.Accent}" CornerRadius="4" Padding="12,8"
                BorderBrush="{DynamicResource Legacy.Brush.Border.Accent}" BorderThickness="1" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📊 Analytics" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource Legacy.Brush.Action.Primary}" VerticalAlignment="Center" Margin="0,0,20,0" />

                <StackPanel Margin="0,0,24,0">
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Legacy.Brush.Action.Primary}">
                        <TextBlock.Text>
                            <Binding Path="HistoryTotalEntries" StringFormat="{}{0}" />
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="Operations" FontSize="10" Foreground="{DynamicResource Legacy.Brush.Fg.Secondary}" />
                </StackPanel>

                <StackPanel Margin="0,0,24,0">
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Legacy.Brush.Success.Fg}">
                        <TextBlock.Text>
                            <Binding Path="HistoryMoveItemCount" StringFormat="{}{0}" />
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock FontSize="10" Foreground="{DynamicResource Legacy.Brush.Fg.Secondary}">
                        <TextBlock.Text>
                            <Binding Path="HistoryMoveOperationCount" StringFormat="files moved ({0} ops)" />
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <StackPanel Margin="0,0,24,0">
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Legacy.Brush.Danger.Fg}">
                        <TextBlock.Text>
                            <Binding Path="HistoryRecycleFileItemCount" StringFormat="{}{0}" />
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock FontSize="10" Foreground="{DynamicResource Legacy.Brush.Fg.Secondary}">
                        <TextBlock.Text>
                            <Binding Path="HistoryRecycleFileOperationCount" StringFormat="files recycled ({0} ops)" />
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <StackPanel Margin="0,0,24,0">
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Legacy.Brush.Danger.Fg}">
                        <TextBlock.Text>
                            <Binding Path="HistoryRecycleDirItemCount" StringFormat="{}{0}" />
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock FontSize="10" Foreground="{DynamicResource Legacy.Brush.Fg.Secondary}">
                        <TextBlock.Text>
                            <Binding Path="HistoryRecycleDirOperationCount" StringFormat="subfolders recycled ({0} ops)" />
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Header actions -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Transaction History" FontSize="13" FontWeight="Bold"
                       Foreground="{DynamicResource Legacy.Brush.Fg.Strong}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button Content="↶ Undo Last" Command="{Binding UndoLastActionCommand}"
                    ToolTip="{Binding UndoTooltip}"
                    Padding="10,4" Margin="0,0,6,0" FontSize="11" Cursor="Hand"
                    FontWeight="SemiBold" Foreground="{DynamicResource Legacy.Brush.Success.Fg}" />
            <Button Content="🗑 Clear History" Command="{Binding ClearHistoryCommand}"
                    Padding="10,4" FontSize="11" Cursor="Hand"
                    Foreground="{DynamicResource Legacy.Brush.Fg.Muted}"
                    ToolTip="Remove all entries from this list. Files are NOT affected." />
        </StackPanel>

        <!-- History list -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Legacy.Brush.Border.Default}" BorderThickness="1" CornerRadius="4">
            <ListView ItemsSource="{Binding ActionHistory}" BorderThickness="0"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.ScrollUnit="Pixel">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Time" Width="140">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="11">
                                        <TextBlock.Text>
                                            <Binding Path="Timestamp" StringFormat="yyyy-MM-dd HH:mm:ss" />
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Action" Width="150"
                                        DisplayMemberBinding="{Binding Kind}" />
                        <GridViewColumn Header="Items" Width="60"
                                        DisplayMemberBinding="{Binding ItemCount}" />
                        <GridViewColumn Header="Summary" Width="500"
                                        DisplayMemberBinding="{Binding Summary}" />
                        <GridViewColumn Header="Undo" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="↶ Undo"
                                            Command="{Binding DataContext.UndoSpecificActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Padding="6,2" FontSize="10" Cursor="Hand"
                                            FontWeight="SemiBold" Foreground="{DynamicResource Legacy.Brush.Success.Fg}"
                                            ToolTip="Undo this specific action" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</UserControl>
