<UserControl x:Class="WindowsFileManager.Views.Screens.FoldersScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:WindowsFileManager.Helpers">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Search patterns (configurable chip list) -->
        <Border Grid.Row="0" Background="{DynamicResource Legacy.Brush.Surface.Accent}" CornerRadius="4" Padding="8,2" Margin="0,0,0,4"
                BorderBrush="{DynamicResource Legacy.Brush.Border.Accent}" BorderThickness="1">
            <StackPanel>
                <WrapPanel Orientation="Horizontal">
                    <!-- Label -->
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2" VerticalAlignment="Center">
                        <TextBlock Text="Folder Search" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Legacy.Brush.Action.Primary}"
                                   VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ToggleButton Style="{StaticResource HelpButtonStyle}"
                                      Tag="&lt;h&gt;FOLDER SEARCH&lt;/h&gt;&#x0a;Search for folders by name across all target paths.&#x0a;&#x0a;&lt;b&gt;How it works:&lt;/b&gt;&#x0a;1. Add folder name patterns to the list&#x0a;2. Click &lt;b&gt;Search&lt;/b&gt; to find matching folders&#x0a;3. Results show every folder matching all enabled patterns&#x0a;&#x0a;&lt;b&gt;Scope:&lt;/b&gt; Uses the same Target Folders and Exclude Folders from the main tab.&#x0a;&lt;b&gt;Matching:&lt;/b&gt; Case-insensitive, and per the match type set on each pattern — see the Match Types help.&#x0a;&lt;b&gt;Depth:&lt;/b&gt; An optional layer limit bounds how deep the search descends. Blank searches every layer.&#x0a;&#x0a;&lt;h&gt;Tip:&lt;/h&gt; Enable/disable patterns to quickly compare different search sets." />
                        <Border Width="1" Background="{DynamicResource Legacy.Brush.Border.Accent}" Margin="8,2" />
                    </StackPanel>

                    <!-- Input -->
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2" VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding FolderMatchTypes}"
                                  SelectedItem="{Binding NewFolderSearchMatchType}"
                                  FontSize="11" Width="92" VerticalContentAlignment="Center"
                                  Margin="0,0,2,0" />
                        <ToggleButton Style="{StaticResource HelpButtonStyle}"
                                      Margin="0,0,4,0"
                                      Tag="&lt;h&gt;MATCH TYPES&lt;/h&gt;&#x0a;&#x0a;&lt;b&gt;Include&lt;/b&gt; — folder name &lt;b&gt;contains&lt;/b&gt; the text (partial match)&#x0a;Example: &quot;log&quot; matches &lt;b&gt;log&lt;/b&gt;s, change&lt;b&gt;log&lt;/b&gt;, &lt;b&gt;log&lt;/b&gt;-backup&#x0a;&#x0a;&lt;b&gt;Match&lt;/b&gt; — folder name &lt;b&gt;exactly equals&lt;/b&gt; the text&#x0a;Example: &quot;bin&quot; matches only &lt;b&gt;bin&lt;/b&gt;, not binary or recycle-bin&#x0a;&#x0a;&lt;b&gt;Contains&lt;/b&gt; — folder has a &lt;b&gt;child item&lt;/b&gt; (file/subfolder) inside it&#x0a;Example: &quot;.git&quot; finds git repos, &quot;*.sln&quot; finds .NET solutions&#x0a;Supports wildcards: &quot;*.py&quot;, &quot;*.csproj&quot;, &quot;*.json&quot;&#x0a;&#x0a;&lt;b&gt;Exclude&lt;/b&gt; — folder name does &lt;b&gt;NOT contain&lt;/b&gt; the text (opposite of Include)&#x0a;Example: &quot;test&quot; skips folders with &quot;test&quot; in the name&#x0a;&#x0a;&lt;b&gt;Mismatch&lt;/b&gt; — folder name does &lt;b&gt;NOT equal&lt;/b&gt; the text (opposite of Match)&#x0a;Example: &quot;bin&quot; skips only the exact &quot;bin&quot; folder&#x0a;&#x0a;&lt;b&gt;NotContain&lt;/b&gt; — folder does &lt;b&gt;NOT&lt;/b&gt; hold a child item matching the pattern (opposite of Contains)&#x0a;Example: &quot;*.sln&quot; skips folders that hold a .NET solution&#x0a;&#x0a;&lt;h&gt;Combining:&lt;/h&gt; All enabled patterns use AND logic.&#x0a;Example: Contains &quot;.git&quot; + Exclude &quot;node_modules&quot;&#x0a;= git repos whose name doesn't include &quot;node_modules&quot;" />
                        <TextBlock Text="name:" FontWeight="SemiBold" FontSize="11"
                                   Foreground="{DynamicResource Legacy.Brush.Fg.Strong}" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <Grid Width="180">
                            <TextBox x:Name="FolderPatternInput"
                                     Text="{Binding NewFolderSearchPattern, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="4,3" FontSize="11" VerticalContentAlignment="Center"
                                     helpers:TextBoxEnterKeyBehavior.Command="{Binding AddFolderSearchPatternCommand}" />
                            <TextBlock Text="folder name or pattern..."
                                       Padding="6,4" FontSize="11" Foreground="{DynamicResource Legacy.Brush.Fg.Disabled}"
                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=FolderPatternInput}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Content="+ Add" Command="{Binding AddFolderSearchPatternCommand}"
                                CommandParameter="{Binding Text, ElementName=FolderPatternInput}"
                                Padding="8,3" Margin="4,0,0,0" FontSize="11" Cursor="Hand"
                                FontWeight="SemiBold" Foreground="{DynamicResource Legacy.Brush.Action.Primary}" />
                        <Border Width="1" Background="{DynamicResource Legacy.Brush.Border.Accent}" Margin="8,2" />
                    </StackPanel>

                    <!-- Search action + status -->
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2" VerticalAlignment="Center">
                        <TextBlock Text="layers:" FontWeight="SemiBold" FontSize="11"
                                   Foreground="{DynamicResource Legacy.Brush.Fg.Strong}" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <Grid Width="56" Margin="0,0,4,0">
                            <TextBox x:Name="FolderSearchDepthInput"
                                     Text="{Binding FolderSearchMaxDepthText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="4,3" FontSize="11" VerticalContentAlignment="Center"
                                     PreviewTextInput="IntegerTextBox_PreviewTextInput"
                                     ToolTip="Maximum subfolder depth to search. Leave empty for no limit. 1 = only direct children of each target folder." />
                            <TextBlock Text="∞"
                                       Padding="6,4" FontSize="11" Foreground="{DynamicResource Legacy.Brush.Fg.Disabled}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=FolderSearchDepthInput}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ToggleButton Style="{StaticResource HelpButtonStyle}" Margin="0,0,8,0"
                                      Tag="&lt;h&gt;SEARCH DEPTH&lt;/h&gt;&#x0a;Limits how deep the recursive search descends from each target folder.&#x0a;&#x0a;&lt;b&gt;Empty&lt;/b&gt; (default) — no limit, walks the full tree&#x0a;&lt;b&gt;1&lt;/b&gt; — only direct children of each target folder&#x0a;&lt;b&gt;2&lt;/b&gt; — children + grandchildren&#x0a;&lt;b&gt;N&lt;/b&gt; — descends N layers&#x0a;&#x0a;&lt;h&gt;Tip:&lt;/h&gt; Set a small depth on huge trees to keep results scoped and the search fast." />
                        <Button Command="{Binding SearchFoldersCommand}"
                                Padding="10,5" FontSize="12" Cursor="Hand"
                                FontWeight="Bold" Foreground="{DynamicResource Legacy.Brush.Surface.White}"
                                BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource Legacy.Brush.Action.Primary}" />
                                    <Setter Property="Content" Value="▶ Search" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="SearchBorder" Background="{TemplateBinding Background}"
                                                        CornerRadius="4" Padding="{TemplateBinding Padding}"
                                                        BorderThickness="0">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="SearchBorder" Property="Background" Value="{DynamicResource Legacy.Brush.Action.PrimaryDark}" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="SearchBorder" Property="Background" Value="{DynamicResource Legacy.Brush.Border.Slate}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFolderSearching}" Value="True">
                                            <Setter Property="Content" Value="⏳ Searching…" />
                                            <Setter Property="Background" Value="{DynamicResource Legacy.Brush.Fg.SlateMuted}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <ToggleButton Style="{StaticResource HelpButtonStyle}" Margin="6,0,0,0"
                                      Tag="&lt;h&gt;SEARCH&lt;/h&gt;&#x0a;Click &lt;b&gt;Search&lt;/b&gt; to find folders matching your patterns.&#x0a;&#x0a;&lt;b&gt;Requirements:&lt;/b&gt;&#x0a;• At least one &lt;b&gt;enabled&lt;/b&gt; target folder (shared from main tab)&#x0a;&#x0a;&lt;b&gt;No patterns?&lt;/b&gt; Returns &lt;b&gt;all folders&lt;/b&gt; (no filtering).&#x0a;&#x0a;&lt;b&gt;How it works:&lt;/b&gt;&#x0a;1. Scans all enabled target folders recursively&#x0a;2. Matches folders against enabled patterns (or returns all)&#x0a;3. Skips excluded folders (shared from main tab)&#x0a;4. Results appear in the list below&#x0a;&#x0a;&lt;h&gt;Then:&lt;/h&gt; Use the &lt;b&gt;Action&lt;/b&gt; section to select and delete/move found folders." />
                        <Button Content="⏹ Stop" Command="{Binding StopFolderSearchCommand}"
                                Padding="8,3" Margin="8,0,0,0" FontSize="11" Cursor="Hand"
                                FontWeight="SemiBold" Foreground="{DynamicResource Legacy.Brush.Danger.Fg}"
                                Visibility="{Binding IsFolderSearching, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Cancel the running search" />
                        <Button Content="✕ Clear" Command="{Binding ClearFolderSearchCommand}"
                                Padding="8,3" Margin="8,0,0,0" FontSize="11" Cursor="Hand"
                                FontWeight="SemiBold" Foreground="{DynamicResource Legacy.Brush.Danger.Fg}"
                                ToolTip="Clear search results and discovered subfolders" />
                        <TextBlock FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Legacy.Brush.Fg.Secondary}" />
                                    <Setter Property="Text" Value="{Binding FolderSearchStatus}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFolderSearching}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Legacy.Brush.Action.Primary}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding FolderPatternAddStatus}" Foreground="{DynamicResource Legacy.Brush.Danger.Fg}"
                                   FontSize="11" FontStyle="Italic" VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </StackPanel>
                </WrapPanel>

                <!-- Search pattern chips -->
                <ItemsControl ItemsSource="{Binding FolderSearchPatterns}" Margin="0,4,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="3" Padding="6,3" Margin="0,0,6,4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Legacy.Brush.Border.Accent}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Legacy.Brush.Accent.Mid}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Opacity" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                <Setter Property="Background" Value="{DynamicResource Legacy.Brush.Surface.Sunken}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Legacy.Brush.Border.Panel}" />
                                                <Setter Property="Opacity" Value="0.6" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"
                                              Margin="0,0,4,0" Cursor="Hand"
                                              ToolTip="Enable or disable this search pattern" />
                                    <!-- Priority number -->
                                    <Border CornerRadius="3" Padding="5,1" Margin="0,0,4,0"
                                            VerticalAlignment="Center" Width="20">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Legacy.Brush.Fg.StrongAlt}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                        <Setter Property="Background" Value="{DynamicResource Legacy.Brush.Border.MidAlt}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Priority}" FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource Legacy.Brush.Surface.White}" HorizontalAlignment="Center" />
                                    </Border>
                                    <!-- Move up/down -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,4,0" VerticalAlignment="Center">
                                        <Button Command="{Binding DataContext.MoveSearchPatternUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" Cursor="Hand" ToolTip="Move up (higher priority)">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="UpBorder" Background="{DynamicResource Legacy.Brush.Border.Default}" CornerRadius="2,0,0,2"
                                                            Padding="3,1" BorderThickness="0">
                                                        <TextBlock Text="▲" FontSize="8" Foreground="{DynamicResource Legacy.Brush.Fg.Body}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="UpBorder" Property="Background" Value="{DynamicResource Legacy.Brush.Action.Primary}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Command="{Binding DataContext.MoveSearchPatternDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" Cursor="Hand" ToolTip="Move down (lower priority)">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="DownBorder" Background="{DynamicResource Legacy.Brush.Border.Default}" CornerRadius="0,2,2,0"
                                                            Padding="3,1" BorderThickness="0">
                                                        <TextBlock Text="▼" FontSize="8" Foreground="{DynamicResource Legacy.Brush.Fg.Body}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="DownBorder" Property="Background" Value="{DynamicResource Legacy.Brush.Action.Primary}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                    <!-- Match type badge -->
                                    <ComboBox ItemsSource="{Binding DataContext.FolderMatchTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding MatchType}"
                                              FontSize="9" Width="80" VerticalContentAlignment="Center"
                                              Margin="0,0,4,0" />
                                    <!-- Editable pattern text -->
                                    <TextBox Text="{Binding Pattern, UpdateSourceTrigger=LostFocus}"
                                             MinWidth="80" Padding="4,2" FontSize="11"
                                             FontWeight="SemiBold" Foreground="{DynamicResource Legacy.Brush.Accent.Deep}"
                                             VerticalContentAlignment="Center"
                                             BorderThickness="0,0,0,1.5" BorderBrush="{DynamicResource Legacy.Brush.Accent.Mid}"
                                             Background="Transparent"
                                             ToolTip="Click to edit pattern" />
                                    <Button Content="✕"
                                            Command="{Binding DataContext.RemoveFolderSearchPatternCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Padding="2,0" Margin="6,0,0,0"
                                            FontSize="9" Foreground="{DynamicResource Legacy.Brush.Danger.Fg}" Cursor="Hand"
                                            Background="Transparent" BorderThickness="0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Row 1: Results list -->
        <ListView Grid.Row="1" ItemsSource="{Binding FolderSearchResults}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  BorderThickness="1" BorderBrush="{DynamicResource Legacy.Brush.Border.Default}"
                  GridViewColumnHeader.Click="FolderResults_ColumnHeaderClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="30">
                        <GridViewColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding DataContext.AreAllFoldersSelected, RelativeSource={RelativeSource AncestorType=Window}}"
                                          Cursor="Hand" ToolTip="Select / deselect all" />
                            </DataTemplate>
                        </GridViewColumn.HeaderTemplate>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" Cursor="Hand" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Folder Name" Width="200"
                                    DisplayMemberBinding="{Binding FolderName}" />
                    <GridViewColumn Header="Size" Width="90"
                                    DisplayMemberBinding="{Binding TotalSizeDisplay}" />
                    <GridViewColumn Header="Full Path" Width="600">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Hyperlink Command="{Binding DataContext.OpenFolderLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               CommandParameter="{Binding FullPath}"
                                               Foreground="{DynamicResource Legacy.Brush.Action.Primary}">
                                        <Run Text="{Binding FullPath, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
