<Window x:Class="WindowsFileManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WindowsFileManager.ViewModels"
        xmlns:chrome="clr-namespace:WindowsFileManager.Views.Chrome"
        xmlns:screens="clr-namespace:WindowsFileManager.Views.Screens"
        xmlns:panels="clr-namespace:WindowsFileManager.Views.Panels"
        Title="Folder File Control"
        Icon="/Assets/app-icon.ico"
        Height="900" Width="1600"
        MinHeight="500" MinWidth="1000"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>


    <DockPanel Margin="4">
        <chrome:ProfileBar DockPanel.Dock="Top" />

        <chrome:AppStatusBar DockPanel.Dock="Bottom" />

        <!-- Main 3-column layout fills remaining space -->
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Column 0: Target Folders + Tabs -->
        <Grid Grid.Column="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <chrome:ScanScopeBar Grid.Row="0" />

        <!-- Row 1: Feature Tabs -->
        <TabControl Grid.Row="1" Margin="4,0,4,4" SelectionChanged="TabControl_SelectionChanged">

            <!-- Tab 1: Folder -->
            <TabItem Header="Folder">
                <screens:FoldersScreen />
            </TabItem>

            <!-- Tab 2: Duplication -->
            <TabItem Header="Duplication">
                <screens:DuplicatesScreen x:Name="DuplicatesView" />
            </TabItem>

            <!-- Tab 3: History (global — gold accent) -->
            <TabItem Background="{DynamicResource Legacy.Brush.History.Bg}" BorderBrush="{DynamicResource Legacy.Brush.History.Border}">
                <TabItem.Header>
                    <TextBlock Text="🕘 History" Foreground="{DynamicResource Legacy.Brush.History.Fg}" FontWeight="Bold" />
                </TabItem.Header>
                <screens:HistoryScreen />
            </TabItem>

        </TabControl>
        </Grid>

        <!-- Column 1: Analytics Dashboard (full window height, toggleable) -->
        <Border Grid.Column="1" Background="{DynamicResource Legacy.Brush.Surface.Card}" CornerRadius="6"
                BorderBrush="{DynamicResource Legacy.Brush.Border.Default}" BorderThickness="1" Padding="12" Margin="4,4,4,4"
                Width="320"
                Visibility="{Binding IsAnalyticsVisible, Converter={StaticResource BoolToVisibility}}">
            <panels:AnalyticsPanel />
        </Border>

        <!-- Column 1: Folder Action Panel (shown when Folder Control tab is active) -->
        <Border Grid.Column="1" Background="{DynamicResource Legacy.Brush.Surface.Card}" CornerRadius="6"
                BorderBrush="{DynamicResource Legacy.Brush.Border.Default}" BorderThickness="1" Padding="12" Margin="4,4,4,4"
                Width="640"
                Visibility="{Binding IsFolderControlActive, Converter={StaticResource BoolToVisibility}}">
            <panels:FolderActionPanel />
        </Border>

        <!-- Column 2: File Preview Panel (full window height) -->
        <Border Grid.Column="2" Background="{DynamicResource Legacy.Brush.Surface.Card}" CornerRadius="6"
                BorderBrush="{DynamicResource Legacy.Brush.Border.Default}" BorderThickness="1" Padding="12" Margin="4,4,4,4"
                Width="380"
                Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibility}}">
            <panels:PreviewPanel x:Name="PreviewView" />
        </Border>

        </Grid>
    </DockPanel>
</Window>
