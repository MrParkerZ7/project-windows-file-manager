<UserControl x:Class="WindowsFileManager.Views.Panels.FolderActionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <!-- Header -->
            <TextBlock Text="Folder Action" FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource Legacy.Brush.Warn.Fg}" Margin="0,0,0,12" />

            <!-- Selection summary -->
            <Border Background="{DynamicResource Legacy.Brush.Surface.White}" CornerRadius="4" Padding="10" Margin="0,0,0,8"
                    BorderBrush="{DynamicResource Legacy.Brush.Border.Default}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Selection" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Legacy.Brush.Fg.Strong}" Margin="0,0,0,6" />
                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Legacy.Brush.Warn.Fg}" Margin="0,0,0,4">
                        <TextBlock.Text>
                            <Binding Path="SelectedFolderCount" StringFormat="{}{0}" />
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="folders selected" FontSize="11" Foreground="{DynamicResource Legacy.Brush.Fg.Muted}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="✓ All" Command="{Binding SelectAllFoldersCommand}"
                                Padding="8,4" Margin="0,0,6,0" FontSize="11" Cursor="Hand" />
                        <Button Content="✕ Clear" Command="{Binding ClearFolderSelectionCommand}"
                                Padding="8,4" FontSize="11" Cursor="Hand" Foreground="{DynamicResource Legacy.Brush.Fg.Muted}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Scan Action -->
            <Border Background="{DynamicResource Legacy.Brush.Surface.White}" CornerRadius="4" Padding="10" Margin="0,0,0,8"
                    BorderBrush="{DynamicResource Legacy.Brush.Border.Default}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Scan Action" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Legacy.Brush.Danger.Fg}" Margin="0,0,0,4" />
                    <TextBlock Text="Click Scan Folders to discover subfolder names and file types inside selected result folders. Select items and clear them."
                               FontSize="10" Foreground="{DynamicResource Legacy.Brush.Fg.Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />

                    <!-- Include subdirectories toggle -->
                    <CheckBox IsChecked="{Binding FolderSearchIncludeSubdirectories}"
                              Content="Include Subdirectories" FontSize="11"
                              Cursor="Hand" Margin="0,0,0,6"
                              ToolTip="When checked, scan recursively into nested subfolders. When unchecked, only scan immediate children." />

                    <!-- Scan button + help -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Command="{Binding ScanSubfoldersCommand}"
                                Padding="10,6" FontSize="11" Cursor="Hand"
                                FontWeight="SemiBold" Foreground="{DynamicResource Legacy.Brush.Action.Primary}"
                                HorizontalAlignment="Stretch"
                                ToolTip="Discover subfolders and file types inside the selected result folders">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Content" Value="🔍 Scan Folders" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScanningFolders}" Value="True">
                                            <Setter Property="Content" Value="⏳ Scanning…" />
                                            <Setter Property="Foreground" Value="{DynamicResource Legacy.Brush.Fg.MutedLight}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <ToggleButton Grid.Column="1" Style="{StaticResource HelpButtonStyle}"
                                      Margin="6,0,0,0"
                                      Tag="&lt;h&gt;SCAN FOLDERS&lt;/h&gt;&#x0a;Inspects the folders you &lt;b&gt;checked&lt;/b&gt; in the Folder Search results and builds two inventories:&#x0a;&#x0a;&lt;b&gt;Subfolders&lt;/b&gt; — unique subfolder names, ranked by how many result folders contain them.&#x0a;Example: &lt;b&gt;node_modules (in 14 folders)&lt;/b&gt;&#x0a;&#x0a;&lt;b&gt;File Types&lt;/b&gt; — unique file extensions, ranked by total file count.&#x0a;Example: &lt;b&gt;.log (237 files)&lt;/b&gt;&#x0a;&#x0a;&lt;b&gt;Scope:&lt;/b&gt;&#x0a;• &lt;b&gt;Include Subdirectories&lt;/b&gt; off — only immediate children of each selected folder&#x0a;• &lt;b&gt;Include Subdirectories&lt;/b&gt; on — recurses through every nested level&#x0a;&#x0a;&lt;b&gt;Expand any item&lt;/b&gt; to see the exact paths it was found in.&#x0a;&#x0a;&lt;h&gt;Next:&lt;/h&gt; Check items then click &lt;b&gt;Clear Selected Subfolders&lt;/b&gt; or &lt;b&gt;Clear Selected Files&lt;/b&gt; to delete them." />
                    </Grid>


                    <!-- Scan status -->
                    <TextBlock FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Legacy.Brush.Fg.Secondary}" />
                                <Setter Property="Text" Value="{Binding ClearSubfolderStatus}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScanningFolders}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Legacy.Brush.Action.Primary}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- ── Subfolders section ── -->
                    <TextBlock Text="Subfolders" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Legacy.Brush.Action.Primary}" Margin="0,0,0,4" />

                    <!-- Filter input -->
                    <Grid Margin="0,0,0,6">
                        <TextBox Text="{Binding SubfolderFilter, UpdateSourceTrigger=PropertyChanged}"
                                 x:Name="SubfolderFilterBox"
                                 Padding="6,4" FontSize="11"
                                 VerticalContentAlignment="Center" />
                        <TextBlock Text="🔍 Filter subfolder names..."
                                   Padding="8,5" FontSize="11" Foreground="{DynamicResource Legacy.Brush.Fg.Disabled}"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SubfolderFilterBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Select All / Clear buttons for subfolders -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="✓ All" Command="{Binding SelectAllSubfoldersCommand}"
                                Padding="8,3" Margin="0,0,6,0" FontSize="10" Cursor="Hand" />
                        <Button Content="✕ None" Command="{Binding ClearSubfolderSelectionCommand}"
                                Padding="8,3" FontSize="10" Cursor="Hand" Foreground="{DynamicResource Legacy.Brush.Fg.Muted}" />
                    </StackPanel>

                    <!-- Subfolder list with expandable details (virtualized, pixel-scroll) -->
                    <Border BorderBrush="{DynamicResource Legacy.Brush.Border.Default}" BorderThickness="1" CornerRadius="3" MaxHeight="280">
                        <ItemsControl ItemsSource="{Binding FilteredSubfolders}"
                                      ScrollViewer.CanContentScroll="True"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="4,2" BorderBrush="{DynamicResource Legacy.Brush.Border.Hairline}" BorderThickness="0,0,0,1">
                                        <Expander IsExpanded="False">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox IsChecked="{Binding IsSelected}" Cursor="Hand"
                                                              VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Legacy.Brush.Fg.Strong}" VerticalAlignment="Center" />
                                                    <TextBlock FontSize="10" Foreground="{DynamicResource Legacy.Brush.Fg.Muted}"
                                                               VerticalAlignment="Center" Margin="6,0,0,0">
                                                        <TextBlock.Text>
                                                            <Binding Path="Count" StringFormat="in {0} folders" />
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <TextBlock Text="·" FontSize="10" Foreground="{DynamicResource Legacy.Brush.Border.Light}"
                                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                                    <TextBlock Text="{Binding TotalSizeDisplay}" FontSize="10"
                                                               Foreground="{DynamicResource Legacy.Brush.Action.Primary}" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </Expander.Header>
                                            <!-- Expanded: filter + paged parent locations -->
                                            <StackPanel Margin="24,4,0,6">
                                                <TextBox Text="{Binding LocationFilter, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                                         FontSize="10" Padding="4,3" Margin="0,0,0,4"
                                                         ToolTip="Filter locations (case-insensitive)" />
                                                <ItemsControl ItemsSource="{Binding PagedLocations}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock FontSize="10" Foreground="{DynamicResource Legacy.Brush.Fg.Secondary}"
                                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                                       Margin="0,1" ToolTip="{Binding FullPath}">
                                                                <Run Text="📁" /><Run Text=" " /><Run Text="{Binding ParentPath, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Button Content="‹ Prev" Click="SubfolderPrevPage_Click"
                                                            IsEnabled="{Binding CanGoPrevPage}"
                                                            Padding="6,2" FontSize="10" Cursor="Hand" />
                                                    <Button Content="Next ›" Click="SubfolderNextPage_Click"
                                                            IsEnabled="{Binding CanGoNextPage}"
                                                            Padding="6,2" Margin="4,0,0,0" FontSize="10" Cursor="Hand" />
                                                    <TextBlock Text="{Binding PageStatus}" FontSize="10"
                                                               Foreground="{DynamicResource Legacy.Brush.Fg.Muted}" VerticalAlignment="Center"
                                                               Margin="10,0,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Expander>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Clear subfolders button + undo + help -->
                    <Grid Margin="0,6,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="🗑 Clear Selected Subfolders"
                                Command="{Binding ClearSelectedSubfoldersCommand}"
                                Padding="10,6" FontSize="11" Cursor="Hand"
                                Foreground="{DynamicResource Legacy.Brush.Danger.Fg}" FontWeight="SemiBold"
                                HorizontalAlignment="Stretch"
                                ToolTip="Delete checked subfolders from all selected result folders" />
                        <Button Grid.Column="1" Content="↶" Command="{Binding UndoLastActionCommand}"
                                ToolTip="{Binding UndoTooltip}"
                                Padding="6,3" Margin="4,0,0,0" FontSize="13" Cursor="Hand"
                                FontWeight="Bold" Foreground="{DynamicResource Legacy.Brush.Success.Fg}" />
                        <ToggleButton Grid.Column="2" Style="{StaticResource HelpButtonStyle}"
                                      Margin="6,0,0,0"
                                      Tag="&lt;h&gt;CLEAR SELECTED SUBFOLDERS&lt;/h&gt;&#x0a;Sends every checked subfolder to the Recycle Bin from inside each selected result folder.&#x0a;&#x0a;&lt;b&gt;What it removes:&lt;/b&gt;&#x0a;• The subfolder itself and all its contents (files and nested subfolders)&#x0a;&#x0a;&lt;b&gt;Common uses:&lt;/b&gt;&#x0a;• Clean &lt;b&gt;node_modules&lt;/b&gt; from many projects at once&#x0a;• Wipe &lt;b&gt;bin&lt;/b&gt;, &lt;b&gt;obj&lt;/b&gt;, &lt;b&gt;.vs&lt;/b&gt; from .NET solutions&#x0a;• Remove &lt;b&gt;__pycache__&lt;/b&gt; across Python repos&#x0a;&#x0a;&lt;b&gt;Safety:&lt;/b&gt;&#x0a;• Confirmation dialog shows affected folder count&#x0a;• Skips subfolders that are locked or access-denied&#x0a;&#x0a;&lt;h&gt;Sent to Recycle Bin — restorable from there.&lt;/h&gt;" />
                    </Grid>

                    <!-- Link Sibling Folders (checked items in Subfolders list = optional filter) -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Layers deep:" FontSize="11"
                                   Foreground="{DynamicResource Legacy.Brush.Fg.Strong}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Column="1" Text="{Binding LinkSiblingsLayer, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="6,3" FontSize="11"
                                 VerticalContentAlignment="Center"
                                 PreviewTextInput="IntegerTextBox_PreviewTextInput"
                                 ToolTip="How many layers deep to cross-link. 1 = only immediate children of each selected folder. Minimum 1." />
                        <TextBlock Grid.Column="2" Text="Prefix:" FontSize="11"
                                   Foreground="{DynamicResource Legacy.Brush.Fg.Strong}" VerticalAlignment="Center" Margin="12,0,8,0" />
                        <TextBox Grid.Column="3" Width="110"
                                 Text="{Binding LinkSiblingsPrefix, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="6,3" FontSize="11"
                                 VerticalContentAlignment="Center" HorizontalAlignment="Left"
                                 ToolTip="Optional prefix prepended to every .lnk filename (e.g. 'link-' produces 'link-sibling.lnk'). Leave empty for no prefix." />
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="🔗 Link Sibling Subfolders"
                                Command="{Binding LinkSiblingFoldersCommand}"
                                Padding="10,6" FontSize="11" Cursor="Hand"
                                Foreground="{DynamicResource Legacy.Brush.Accent.Violet}" FontWeight="SemiBold"
                                HorizontalAlignment="Stretch"
                                ToolTip="Create .lnk shortcuts linking sibling subfolders inside each selected folder" />
                        <Button Grid.Column="1" Content="↶" Command="{Binding UndoLastActionCommand}"
                                ToolTip="{Binding UndoTooltip}"
                                Padding="6,3" Margin="4,0,0,0" FontSize="13" Cursor="Hand"
                                FontWeight="Bold" Foreground="{DynamicResource Legacy.Brush.Success.Fg}" />
                        <ToggleButton Grid.Column="2" Style="{StaticResource HelpButtonStyle}"
                                      Margin="6,0,0,0"
                                      Tag="&lt;h&gt;LINK SIBLING FOLDERS&lt;/h&gt;&#x0a;Creates Windows shortcuts (.lnk) inside each subfolder pointing to its siblings under the same parent.&#x0a;&#x0a;&lt;b&gt;Optional filter:&lt;/b&gt; Check items in the Subfolders list above to narrow linking to those names only. Unchecked = link all siblings.&#x0a;&#x0a;&lt;b&gt;Example (Layers deep = 1):&lt;/b&gt;&#x0a;Before:&#x0a;  some-folder\1\&#x0a;  some-folder\2\&#x0a;  some-folder\3\&#x0a;&#x0a;After:&#x0a;  some-folder\1\2.lnk&#x0a;  some-folder\1\3.lnk&#x0a;  some-folder\2\1.lnk&#x0a;  some-folder\2\3.lnk&#x0a;  some-folder\3\1.lnk&#x0a;  some-folder\3\2.lnk&#x0a;&#x0a;&lt;b&gt;Layers deep:&lt;/b&gt; How many levels to descend while cross-linking. Shortcuts never cross parent folders — only siblings under the SAME parent get linked.&#x0a;&#x0a;&lt;b&gt;Safety:&lt;/b&gt;&#x0a;• Existing shortcuts with the same name are skipped&#x0a;• Undo (↶) deletes the created .lnk files" />
                    </Grid>

                    <!-- ── File Types section ── -->
                    <TextBlock Text="File Types" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Legacy.Brush.Action.Primary}" Margin="0,0,0,4" />

                    <!-- File type filter -->
                    <Grid Margin="0,0,0,6">
                        <TextBox Text="{Binding FileTypeFilter, UpdateSourceTrigger=PropertyChanged}"
                                 x:Name="FileTypeFilterBox"
                                 Padding="6,4" FontSize="11"
                                 VerticalContentAlignment="Center" />
                        <TextBlock Text="🔍 Filter extensions (e.g. .log)..."
                                   Padding="8,5" FontSize="11" Foreground="{DynamicResource Legacy.Brush.Fg.Disabled}"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=FileTypeFilterBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Select All / Clear buttons for file types -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="✓ All" Command="{Binding SelectAllFileTypesCommand}"
                                Padding="8,3" Margin="0,0,6,0" FontSize="10" Cursor="Hand" />
                        <Button Content="✕ None" Command="{Binding ClearFileTypeSelectionCommand}"
                                Padding="8,3" FontSize="10" Cursor="Hand" Foreground="{DynamicResource Legacy.Brush.Fg.Muted}" />
                    </StackPanel>

                    <!-- File types list with expandable details (virtualized, pixel-scroll) -->
                    <Border BorderBrush="{DynamicResource Legacy.Brush.Border.Default}" BorderThickness="1" CornerRadius="3" MaxHeight="280">
                        <ItemsControl ItemsSource="{Binding FilteredFileTypes}"
                                      ScrollViewer.CanContentScroll="True"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="4,2" BorderBrush="{DynamicResource Legacy.Brush.Border.Hairline}" BorderThickness="0,0,0,1">
                                        <Expander IsExpanded="False">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox IsChecked="{Binding IsSelected}" Cursor="Hand"
                                                              VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Legacy.Brush.Fg.Strong}" VerticalAlignment="Center" />
                                                    <TextBlock FontSize="10" Foreground="{DynamicResource Legacy.Brush.Fg.Muted}"
                                                               VerticalAlignment="Center" Margin="6,0,0,0">
                                                        <TextBlock.Text>
                                                            <Binding Path="Count" StringFormat="{}{0} files" />
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <TextBlock Text="·" FontSize="10" Foreground="{DynamicResource Legacy.Brush.Border.Light}"
                                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                                    <TextBlock Text="{Binding TotalSizeDisplay}" FontSize="10"
                                                               Foreground="{DynamicResource Legacy.Brush.Action.Primary}" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </Expander.Header>
                                            <!-- Expanded: filter + paged file paths -->
                                            <StackPanel Margin="24,4,0,6">
                                                <TextBox Text="{Binding LocationFilter, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                                         FontSize="10" Padding="4,3" Margin="0,0,0,4"
                                                         ToolTip="Filter file paths (case-insensitive)" />
                                                <ItemsControl ItemsSource="{Binding PagedLocations}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock FontSize="10" Foreground="{DynamicResource Legacy.Brush.Fg.Secondary}"
                                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                                       Margin="0,1" ToolTip="{Binding FullPath}">
                                                                <Run Text="📄" /><Run Text=" " /><Run Text="{Binding FullPath, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Button Content="‹ Prev" Click="SubfolderPrevPage_Click"
                                                            IsEnabled="{Binding CanGoPrevPage}"
                                                            Padding="6,2" FontSize="10" Cursor="Hand" />
                                                    <Button Content="Next ›" Click="SubfolderNextPage_Click"
                                                            IsEnabled="{Binding CanGoNextPage}"
                                                            Padding="6,2" Margin="4,0,0,0" FontSize="10" Cursor="Hand" />
                                                    <TextBlock Text="{Binding PageStatus}" FontSize="10"
                                                               Foreground="{DynamicResource Legacy.Brush.Fg.Muted}" VerticalAlignment="Center"
                                                               Margin="10,0,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Expander>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Clear files button + undo + help -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="🗑 Clear Selected Files"
                                Command="{Binding ClearSelectedFileTypesCommand}"
                                Padding="10,6" FontSize="11" Cursor="Hand"
                                Foreground="{DynamicResource Legacy.Brush.Danger.Fg}" FontWeight="SemiBold"
                                HorizontalAlignment="Stretch"
                                ToolTip="Delete all files of checked types inside selected result folders" />
                        <Button Grid.Column="1" Content="↶" Command="{Binding UndoLastActionCommand}"
                                ToolTip="{Binding UndoTooltip}"
                                Padding="6,3" Margin="4,0,0,0" FontSize="13" Cursor="Hand"
                                FontWeight="Bold" Foreground="{DynamicResource Legacy.Brush.Success.Fg}" />
                        <ToggleButton Grid.Column="2" Style="{StaticResource HelpButtonStyle}"
                                      Margin="6,0,0,0"
                                      Tag="&lt;h&gt;CLEAR SELECTED FILES&lt;/h&gt;&#x0a;Sends every file whose extension is checked to the Recycle Bin, from inside each selected result folder.&#x0a;&#x0a;&lt;b&gt;What it removes:&lt;/b&gt;&#x0a;• Each matching file found during &lt;b&gt;Scan Folders&lt;/b&gt;&#x0a;• Only files — subfolders are never touched by this action&#x0a;&#x0a;&lt;b&gt;Scope:&lt;/b&gt;&#x0a;• Follows the same &lt;b&gt;Include Subdirectories&lt;/b&gt; setting used during the scan&#x0a;&#x0a;&lt;b&gt;Common uses:&lt;/b&gt;&#x0a;• Purge &lt;b&gt;.log&lt;/b&gt;, &lt;b&gt;.tmp&lt;/b&gt;, &lt;b&gt;.bak&lt;/b&gt; files across many folders&#x0a;• Remove stray &lt;b&gt;.DS_Store&lt;/b&gt; / &lt;b&gt;Thumbs.db&lt;/b&gt;&#x0a;&#x0a;&lt;b&gt;Safety:&lt;/b&gt;&#x0a;• Confirmation dialog shows exact file count + extension list&#x0a;• Skips files that are locked or access-denied&#x0a;&#x0a;&lt;h&gt;Sent to Recycle Bin — restorable from there.&lt;/h&gt;" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Flatten Folders (dedicated subfolder file-type scan) -->
            <Border Background="{DynamicResource Legacy.Brush.Surface.White}" CornerRadius="4" Padding="10" Margin="0,0,0,8"
                    BorderBrush="{DynamicResource Legacy.Brush.Border.Default}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Flatten Folders" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Legacy.Brush.Danger.Fg}" Margin="0,0,0,4" />
                    <TextBlock Text="Move files from subdirectories up to the root of each selected folder. Name conflicts resolved with (2), (3)."
                               FontSize="10" Foreground="{DynamicResource Legacy.Brush.Fg.Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />

                    <CheckBox IsChecked="{Binding FlattenRemoveEmptyFolders}"
                              Content="Remove empty subfolders after move" FontSize="11"
                              Cursor="Hand" Margin="0,0,0,4"
                              ToolTip="When on, deletes now-empty subdirectories after flattening. When off, the directory structure stays intact with only its files moved to the root." />
                    <TextBlock Text="If any file types are checked below, only those are moved. If none are checked, all files move."
                               FontSize="10" Foreground="{DynamicResource Legacy.Brush.Fg.Muted}" FontStyle="Italic"
                               TextWrapping="Wrap" Margin="0,0,0,8" />

                    <!-- Subfolder file-type scan (root files excluded) -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Command="{Binding ScanFlattenFileTypesCommand}"
                                Padding="8,5" FontSize="11" Cursor="Hand"
                                FontWeight="SemiBold" Foreground="{DynamicResource Legacy.Brush.Action.Primary}"
                                HorizontalAlignment="Stretch"
                                ToolTip="Discover file types inside subfolders only (root-level files excluded)">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Content" Value="🔍 Scan Subfolder File Types" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScanningFlattenTypes}" Value="True">
                                            <Setter Property="Content" Value="⏳ Scanning…" />
                                            <Setter Property="Foreground" Value="{DynamicResource Legacy.Brush.Fg.MutedLight}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <Grid Margin="0,4,0,4">
                        <TextBox Text="{Binding FlattenFileTypeFilter, UpdateSourceTrigger=PropertyChanged}"
                                 x:Name="FlattenFileTypeFilterBox"
                                 Padding="6,3" FontSize="11"
                                 VerticalContentAlignment="Center" />
                        <TextBlock Text="🔍 Filter extensions (e.g. .mp4)..."
                                   Padding="8,5" FontSize="11" Foreground="{DynamicResource Legacy.Brush.Fg.Disabled}"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=FlattenFileTypeFilterBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="✓ All" Command="{Binding SelectAllFlattenFileTypesCommand}"
                                Padding="8,3" Margin="0,0,6,0" FontSize="10" Cursor="Hand" />
                        <Button Content="✕ None" Command="{Binding ClearFlattenFileTypeSelectionCommand}"
                                Padding="8,3" FontSize="10" Cursor="Hand" Foreground="{DynamicResource Legacy.Brush.Fg.Muted}" />
                    </StackPanel>

                    <Border BorderBrush="{DynamicResource Legacy.Brush.Border.Default}" BorderThickness="1" CornerRadius="3" MaxHeight="200" Margin="0,0,0,8">
                        <ItemsControl ItemsSource="{Binding FilteredFlattenFileTypes}"
                                      ScrollViewer.CanContentScroll="True"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="4,2" BorderBrush="{DynamicResource Legacy.Brush.Border.Hairline}" BorderThickness="0,0,0,1">
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding IsSelected}" Cursor="Hand"
                                                      VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Legacy.Brush.Fg.Strong}" VerticalAlignment="Center" />
                                            <TextBlock FontSize="10" Foreground="{DynamicResource Legacy.Brush.Fg.Muted}" VerticalAlignment="Center" Margin="6,0,0,0">
                                                <TextBlock.Text>
                                                    <Binding Path="Count" StringFormat="{}{0} files" />
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock Text="·" FontSize="10" Foreground="{DynamicResource Legacy.Brush.Border.Light}"
                                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                                            <TextBlock Text="{Binding TotalSizeDisplay}" FontSize="10"
                                                       Foreground="{DynamicResource Legacy.Brush.Action.Primary}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="📦 Move Files to Root"
                                Command="{Binding FlattenSelectedFoldersCommand}"
                                Padding="10,6" FontSize="11" Cursor="Hand"
                                Foreground="{DynamicResource Legacy.Brush.Danger.Fg}" FontWeight="SemiBold"
                                HorizontalAlignment="Stretch"
                                ToolTip="Move files from subdirectories up to the root of each selected folder" />
                        <Button Grid.Column="1" Content="↶" Command="{Binding UndoLastActionCommand}"
                                ToolTip="{Binding UndoTooltip}"
                                Padding="6,3" Margin="4,0,0,0" FontSize="13" Cursor="Hand"
                                FontWeight="Bold" Foreground="{DynamicResource Legacy.Brush.Success.Fg}" />
                        <ToggleButton Grid.Column="2" Style="{StaticResource HelpButtonStyle}"
                                      Margin="6,0,0,0"
                                      Tag="&lt;h&gt;MOVE FILES TO ROOT&lt;/h&gt;&#x0a;Flattens every selected result folder — moves files from nested subdirectories up to the folder's own root.&#x0a;&#x0a;&lt;b&gt;Example:&lt;/b&gt;&#x0a;Before:&#x0a;  Photos\2024\Jan\a.jpg&#x0a;  Photos\2024\Feb\b.jpg&#x0a;  Photos\2024\Feb\sub\c.jpg&#x0a;&#x0a;After:&#x0a;  Photos\2024\a.jpg&#x0a;  Photos\2024\b.jpg&#x0a;  Photos\2024\c.jpg&#x0a;&#x0a;&lt;b&gt;Options:&lt;/b&gt;&#x0a;• &lt;b&gt;Remove empty subfolders&lt;/b&gt; — deletes empty directories after flattening&#x0a;• &lt;b&gt;Only selected file types&lt;/b&gt; — limits the move to extensions checked in the list above&#x0a;&#x0a;&lt;b&gt;Note:&lt;/b&gt; The file-type list above shows only files found in &lt;b&gt;subfolders&lt;/b&gt; (root-level files are excluded — they stay put anyway).&#x0a;&#x0a;&lt;b&gt;Safety:&lt;/b&gt;&#x0a;• Confirmation dialog shows affected file count + the filter in effect&#x0a;• Skips files that are locked or access-denied&#x0a;• Appends (2), (3) to resolve name conflicts&#x0a;&#x0a;&lt;h&gt;Undo (↶) reverses the last action.&lt;/h&gt;" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Search info -->
            <Border Background="{DynamicResource Legacy.Brush.Surface.White}" CornerRadius="4" Padding="10" Margin="0,0,0,8"
                    BorderBrush="{DynamicResource Legacy.Brush.Border.Default}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Results" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Legacy.Brush.Fg.Strong}" Margin="0,0,0,6" />
                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Legacy.Brush.Action.Primary}" Margin="0,0,0,4">
                        <TextBlock.Text>
                            <Binding Path="FolderSearchCount" StringFormat="{}{0}" />
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="folders found" FontSize="11" Foreground="{DynamicResource Legacy.Brush.Fg.Muted}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding FolderSearchStatus}" FontSize="10" Foreground="{DynamicResource Legacy.Brush.Fg.Secondary}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
