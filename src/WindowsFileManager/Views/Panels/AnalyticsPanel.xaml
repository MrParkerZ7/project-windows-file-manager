<UserControl x:Class="WindowsFileManager.Views.Panels.AnalyticsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:WindowsFileManager.Helpers">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel DataContext="{Binding Analytics}">

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Analytics" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource Legacy.Brush.Accent.Deepest}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="✕ Close" Padding="8,4"
                        FontSize="11" Cursor="Hand" Foreground="{DynamicResource Legacy.Brush.Fg.Secondary}"
                        Click="CloseAnalytics_Click" />
            </Grid>

            <!-- Summary Cards -->
            <Border Background="{DynamicResource Legacy.Brush.Surface.White}" CornerRadius="4" Padding="10" Margin="0,0,0,8"
                    BorderBrush="{DynamicResource Legacy.Brush.Border.Default}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                        <TextBlock Text="Total Files" Foreground="{DynamicResource Legacy.Brush.Fg.MutedLight}" FontSize="10" />
                        <TextBlock Text="{Binding TotalFiles, StringFormat=N0}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Legacy.Brush.Fg.Strong}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                        <TextBlock Text="Duplicates" Foreground="{DynamicResource Legacy.Brush.Fg.MutedLight}" FontSize="10" />
                        <TextBlock Text="{Binding TotalDuplicates, StringFormat=N0}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Legacy.Brush.Danger.Fg}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                        <TextBlock Text="Groups" Foreground="{DynamicResource Legacy.Brush.Fg.MutedLight}" FontSize="10" />
                        <TextBlock Text="{Binding DuplicateGroups, StringFormat=N0}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Legacy.Brush.Action.Primary}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                        <TextBlock Text="Scan Time" Foreground="{DynamicResource Legacy.Brush.Fg.MutedLight}" FontSize="10" />
                        <TextBlock Text="{Binding Duration, StringFormat='{}{0:mm\\:ss\\.f}'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Legacy.Brush.Fg.Strong}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="Wasted Space" Foreground="{DynamicResource Legacy.Brush.Fg.MutedLight}" FontSize="10" />
                        <TextBlock Text="{Binding FormattedWastedSize}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Legacy.Brush.Danger.Fg}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1">
                        <TextBlock Text="Duplicate %" Foreground="{DynamicResource Legacy.Brush.Fg.MutedLight}" FontSize="10" />
                        <TextBlock Text="{Binding DuplicatePercentage, StringFormat='{}{0:F1}%'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Legacy.Brush.Warn.Fg}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Wasted Space Bar -->
            <Border Background="{DynamicResource Legacy.Brush.Surface.White}" CornerRadius="4" Padding="10" Margin="0,0,0,8"
                    BorderBrush="{DynamicResource Legacy.Brush.Border.Default}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Wasted vs Total" FontWeight="SemiBold" FontSize="11"
                               Foreground="{DynamicResource Legacy.Brush.Fg.Body}" Margin="0,0,0,6" />
                    <Grid Height="20">
                        <Border Background="{DynamicResource Legacy.Brush.Success.Tint}" CornerRadius="3" />
                        <Border Background="{DynamicResource Legacy.Brush.Danger.Tint}" CornerRadius="3"
                                HorizontalAlignment="Left">
                            <Border.Width>
                                <MultiBinding Converter="{x:Static helpers:PercentToWidthConverter.Instance}">
                                    <Binding Path="WastedPercentage" />
                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Border Width="10" Height="10" Background="{DynamicResource Legacy.Brush.Danger.Tint}" CornerRadius="2" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding FormattedWastedSize, StringFormat='Wasted: {0}'}" FontSize="10" Foreground="{DynamicResource Legacy.Brush.Fg.Secondary}" Margin="0,0,12,0" />
                        <Border Width="10" Height="10" Background="{DynamicResource Legacy.Brush.Success.Tint}" CornerRadius="2" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding FormattedTotalSize, StringFormat='Total: {0}'}" FontSize="10" Foreground="{DynamicResource Legacy.Brush.Fg.Secondary}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Top Extensions -->
            <Border Background="{DynamicResource Legacy.Brush.Surface.White}" CornerRadius="4" Padding="10" Margin="0,0,0,8"
                    BorderBrush="{DynamicResource Legacy.Brush.Border.Default}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Top Duplicate Types" FontWeight="SemiBold" FontSize="11"
                               Foreground="{DynamicResource Legacy.Brush.Fg.Body}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding TopExtensions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource Legacy.Brush.Surface.InfoTint}" CornerRadius="3"
                                            Padding="4,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Extension}" FontSize="10"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource Legacy.Brush.Action.Primary}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding FileCount, StringFormat='{}{0} files'}"
                                               FontSize="10" Foreground="{DynamicResource Legacy.Brush.Fg.Muted}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding FormattedSize}"
                                               FontSize="10" Foreground="{DynamicResource Legacy.Brush.Fg.Secondary}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Size Distribution -->
            <Border Background="{DynamicResource Legacy.Brush.Surface.White}" CornerRadius="4" Padding="10"
                    BorderBrush="{DynamicResource Legacy.Brush.Border.Default}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Size Distribution" FontWeight="SemiBold" FontSize="11"
                               Foreground="{DynamicResource Legacy.Brush.Fg.Body}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding SizeDistribution}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{DynamicResource Legacy.Brush.Fg.Secondary}" />
                                        <TextBlock Text="{Binding FileCount, StringFormat=' ({0})'}" FontSize="10" Foreground="{DynamicResource Legacy.Brush.Fg.MutedLight}" />
                                    </StackPanel>
                                    <Grid Grid.Row="1" Height="8" Margin="0,2,0,0">
                                        <Border Background="{DynamicResource Legacy.Brush.Surface.Sunken}" CornerRadius="2" />
                                        <Border Background="{DynamicResource Legacy.Brush.Accent.Mid}" CornerRadius="2"
                                                HorizontalAlignment="Left">
                                            <Border.Width>
                                                <MultiBinding Converter="{x:Static helpers:PercentToWidthConverter.Instance}">
                                                    <Binding Path="BarWidth" />
                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                                </MultiBinding>
                                            </Border.Width>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
